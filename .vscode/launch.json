{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug cpulse",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/cpulse.exe",
      // "args": ["--model", ".cache/Qwen2.5-0.5B", "--view"],
      "args": ["--model", ".cache/t5-small", "--view"],
      // "args": ["--model", ".cache/t5-small", "--token", "\"translate English to German: Hello\""],
      "stopAtEntry": false,
      "internalConsoleOptions": "openOnSessionStart",
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
