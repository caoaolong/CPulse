{
  "configurations": [
    {
      "name": "Cygwin",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/third_party/cJSON",
        "${workspaceFolder}/third_party/mongoose",
        "C:/cygwin64/usr/include",
        "C:/cygwin64/lib/gcc/x86_64-pc-cygwin/14/include",
        "C:/cygwin64/usr/include/w32api"
      ],
      "defines": [
        "__CYGWIN__",
        "_GNU_SOURCE",
        "MG_TLS=MG_TLS_NONE",
        "MG_ENABLE_EPOLL=0"
      ],
      "compilerPath": "C:/cygwin64/bin/gcc.exe",
      "cStandard": "c11",
      "cppStandard": "c++17",
      "intelliSenseMode": "windows-gcc-x64"
    }
  ],
  "version": 4
}
